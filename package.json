{
  "name": "makeshift-discord",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "biome check --write backend/src/",
    "prepare": "node -e \"if(process.env.NODE_ENV!=='production')require('child_process').execSync('husky',{stdio:'inherit'})\"",
    "backend:dev": "pnpm --filter backend dev",
    "backend:start": "pnpm --filter backend start",
    "frontend:dev": "pnpm --filter frontend dev",
    "frontend:start": "pnpm --filter frontend preview",
    "backend:image:build": "docker build -f backend/Dockerfile -t ghcr.io/yzhu112/makeshift-discord-backend:latest -t ghcr.io/yzhu112/makeshift-discord-backend:$(git rev-parse --short HEAD) .",
    "backend:image:push": "docker push ghcr.io/yzhu112/makeshift-discord-backend --all-tags",
    "backend:image:publish": "pnpm backend:image:build && pnpm backend:image:push",
    "frontend:image:build": "docker build -f frontend/Dockerfile -t ghcr.io/yzhu112/makeshift-discord-frontend:latest -t ghcr.io/yzhu112/makeshift-discord-frontend:$(git rev-parse --short HEAD) .",
    "frontend:image:push": "docker push ghcr.io/yzhu112/makeshift-discord-frontend --all-tags",
    "frontend:image:publish": "pnpm frontend:image:build && pnpm frontend:image:push",
    "db:query": "sqlite3 $INIT_CWD/backend/data/voicechat.db",
    "livekit": "docker compose up",
    "livekit:detach": "docker compose up -d"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "husky": "^9.1.7"
  }
}
